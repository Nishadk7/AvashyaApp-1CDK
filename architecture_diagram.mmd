graph TD
    %% Styling & Colors
    classDef r53 fill:#8C4FFF,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef cf fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef s3 fill:#1D893B,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef alb fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef ec2 fill:#FF9900,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef rds fill:#C71385,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef cw fill:#C71385,stroke:#232F3E,stroke-width:2px,color:#fff;
    classDef vpcfill fill:#ffffff,stroke:#8C4FFF,stroke-width:2px,stroke-dasharray: 5 5;

    %% Global Edge & DNS Layer (Outside VPC)
    subgraph EdgeLayer["Global Edge & Content Delivery Layer"]
        Route53["AWS Route 53<br/>(Apex & WWW Alias A-Records)"]:::r53
        CloudFront["Amazon CloudFront Distribution<br/>(OAC Enabled - HTTPS)"]:::cf
        WebBucket[("S3 Web Frontend Bucket<br/>(nishadinternsip-avashya-web-frontend-2026)")]:::s3
    end

    %% Storage Layer (Outside VPC / Gateway Endpoint)
    subgraph StorageLayer["S3 Data Storage Layer"]
        UploadBucket[("S3 File Drop Bucket<br/>(nishadinternsip-avashya-drop-uploads-2026)")]:::s3
    end

    %% Custom Amazon VPC
    subgraph VPC["Custom VPC: NishadInternsip-AvashyaVpc (10.0.0.0/16 across 2 AZs)"]
        
        %% Public Subnet
        subgraph PublicSubnets["Public Subnets (AZ-1: 10.0.1.0/24 | AZ-2: 10.0.2.0/24)"]
            ALB["Single Application Load Balancer<br/>(nishadinternsip-alb - Port 80)"]:::alb
            NAT["Regional NAT Gateway & IGW"]:::r53
        end

        %% Private App Subnets
        subgraph AppSubnets["Private App Subnets with Egress (AZ-1: 10.0.10.0/24 | AZ-2: 10.0.11.0/24)"]
            subgraph AppASG["⚡ App Tier Auto Scaling Group (NishadInternsip-App-Tier-ASG)<br/>[Min: 1, Max: 3 - CPU > 70%]"]
                EC2_App1["App EC2 Instance (AZ-1)<br/>(Python API Server - Port 8000)"]:::ec2
                EC2_App2["App EC2 Instance (AZ-2)<br/>(Python API Server - Port 8000)"]:::ec2
            end
            S3Endpoint["S3 Gateway VPC Endpoint"]:::s3
        end

        %% Private DB Subnets
        subgraph DBSubnets["Private Isolated DB Subnets (AZ-1: 10.0.20.0/24 | AZ-2: 10.0.21.0/24)"]
            RDS_DB["Amazon RDS PostgreSQL<br/>(Single-AZ Instance - Port 5432)"]:::rds
        end

    end

    %% Monitoring Layer
    CloudWatch["Amazon CloudWatch Log Group<br/>(/aws/ec2/.../AppTier)"]:::cw

    %% Traffic & Request Flows
    Route53 -->|1. Alias DNS Resolution| CloudFront
    CloudFront -->|2. Default Behavior /*| WebBucket
    CloudFront -->|3. Behavior /api/*| ALB

    ALB -->|4. Security Group Rule (Port 8000)| EC2_App1
    ALB -->|4. Security Group Rule (Port 8000)| EC2_App2

    EC2_App1 -->|5. Security Group Rule (Port 5432)| RDS_DB
    EC2_App2 -->|5. Security Group Rule (Port 5432)| RDS_DB

    EC2_App1 -->|6. S3 Gateway Endpoint| UploadBucket
    EC2_App2 -->|6. S3 Gateway Endpoint| UploadBucket

    EC2_App1 -.->|7. Stream Application Logs| CloudWatch
    EC2_App2 -.->|7. Stream Application Logs| CloudWatch
