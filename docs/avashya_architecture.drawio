<mxfile host="Electron" version="29.6.1">
  <diagram name="AvashyaApp Architecture" id="avashya-arch-1">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Header Title Block -->
        <mxCell id="title" value="AvashyaApp - Production Cloud Architecture" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontFamily=Helvetica;fontColor=light-dark(#232F3E, #FAFAFA);" vertex="1" parent="1">
