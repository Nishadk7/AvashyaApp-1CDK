        </mxCell>
        <mxCell id="leg-1" value="1. Route 53 Public Hosted Zone&#10;Apex &amp; WWW Alias A-records point to CloudFront" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Helvetica;fontSize=10;fontColor=light-dark(#545B64, #D5DBDB);" vertex="1" parent="legend-box">
          <mxGeometry x="10" y="35" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg-2" value="2. CloudFront CDN &amp; OAC&#10;Routes /* to S3 Web Bucket &amp; /api/* to ALB" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Helvetica;fontSize=10;fontColor=light-dark(#545B64, #D5DBDB);" vertex="1" parent="legend-box">
          <mxGeometry x="10" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg-3" value="3. S3 Web Frontend Bucket&#10;Stores static HTML/JS/CSS assets (100% Private)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Helvetica;fontSize=10;fontColor=light-dark(#545B64, #D5DBDB);" vertex="1" parent="legend-box">
          <mxGeometry x="10" y="125" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg-4" value="4. Public Subnet &amp; Single ALB&#10;Inbound HTTP/HTTPS (Port 80) from CloudFront" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Helvetica;fontSize=10;fontColor=light-dark(#545B64, #D5DBDB);" vertex="1" parent="legend-box">
          <mxGeometry x="10" y="170" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="leg-5" value="5. Private App Subnet EC2 ASG&#10;Python API servers in private subnets (Port 8000)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontFamily=Helvetica;fontSize=10;fontColor=light-dark(#545B64, #D5DBDB);" vertex="1" parent="legend-box">
