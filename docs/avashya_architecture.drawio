        </mxCell>
        <mxCell id="subtitle" value="Static Web Tier (S3 + CloudFront OAC) | Scalable Compute (Single ALB + Private EC2 ASG) | Single-AZ RDS PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=0;fontFamily=Helvetica;fontColor=light-dark(#545B64, #D5DBDB);" vertex="1" parent="1">
